<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="UtilityGamer.WinUI.Views.Controls.NumericSpinner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    MinWidth="88">

    <Border
        Background="{StaticResource CardBrush}"
        BorderBrush="{StaticResource CardBorderBrush}"
        BorderThickness="1"
        CornerRadius="6"
        Height="32">

        <Grid ColumnDefinitions="*,24">

            <!-- Value text box -->
            <TextBox
                x:Name="ValueBox"
                Grid.Column="0"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch"
                Padding="8,0,4,0"
                FontSize="13"
                BorderThickness="0"
                Background="Transparent"
                Foreground="{StaticResource FgBrush}"
                TextAlignment="Left"
                InputScope="Number"
                TextChanged="OnTextChanged"
                LostFocus="OnLostFocus"
                KeyDown="OnKeyDown"/>

            <!-- Spin buttons -->
            <Grid
                Grid.Column="1"
                RowDefinitions="*,*"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1,0,0,0">

                <RepeatButton
                    x:Name="UpButton"
                    Grid.Row="0"
                    Click="OnUp"
                    Delay="400"
                    Interval="80"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    FontSize="8"
                    Foreground="{StaticResource MutedFgBrush}"
                    Content="▲"
                    CornerRadius="0,6,0,0">
                    <RepeatButton.Resources>
                        <SolidColorBrush x:Key="RepeatButtonBackgroundPointerOver" Color="#1E2D3D"/>
                        <SolidColorBrush x:Key="RepeatButtonBackgroundPressed"     Color="#263545"/>
                    </RepeatButton.Resources>
                </RepeatButton>

                <RepeatButton
                    x:Name="DownButton"
                    Grid.Row="1"
                    Click="OnDown"
                    Delay="400"
                    Interval="80"
                    Background="Transparent"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    Padding="0"
                    FontSize="8"
                    Foreground="{StaticResource MutedFgBrush}"
                    Content="▼"
                    CornerRadius="0,0,6,0">
                    <RepeatButton.Resources>
                        <SolidColorBrush x:Key="RepeatButtonBackgroundPointerOver" Color="#1E2D3D"/>
                        <SolidColorBrush x:Key="RepeatButtonBackgroundPressed"     Color="#263545"/>
                    </RepeatButton.Resources>
                </RepeatButton>

            </Grid>
        </Grid>
    </Border>
</UserControl>
